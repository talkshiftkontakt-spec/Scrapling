# API
PORT=3101
NODE_ENV=development

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgres://design:design@localhost:5432/design_intelligence

# Qdrant (optional for first references; required later for semantic search)
QDRANT_URL=http://localhost:6333

# Storage: local (default) or drive
STORAGE_MODE=local
DESIGN_LIBRARY_PATH=./DesignLibrary
STATIC_BASE_URL=http://127.0.0.1:3101/static
# Per-page capture: viewport screenshots per route (desktop + mobile), not full-page scrolls
CAPTURE_MODE=viewport
MAX_PAGES_PER_SITE=6
PAGE_CAPTURE_TIMEOUT_MS=45000

# Google Drive (only when STORAGE_MODE=drive)
GOOGLE_DRIVE_SHARED_ROOT=DesignLibrary
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# AI providers (optional for first run — heuristic analysis is used without keys)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Python ingestion
INGESTION_API_URL=http://127.0.0.1:3101

# Dashboard (port 3100 — avoids conflicts with other apps on 3000)
NEXT_PUBLIC_API_URL=http://127.0.0.1:3101
DASHBOARD_PORT=3100
