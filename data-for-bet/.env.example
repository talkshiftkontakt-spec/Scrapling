# SportsData API
SPORTSDATA_HOST=0.0.0.0
SPORTSDATA_PORT=8080
SPORTSDATA_DB_PATH=data/sportsdata.db

# Optional API protection
# SPORTSDATA_API_KEY=change-me
# SPORTSDATA_REQUIRE_API_KEY=true

# CORS for your frontend (comma-separated)
SPORTSDATA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Pagination defaults
SPORTSDATA_DEFAULT_PAGE_SIZE=50
SPORTSDATA_MAX_PAGE_SIZE=500
